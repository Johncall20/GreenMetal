# Lista branca: tudo fica fora por padrao, e so entra o que esta liberado aqui.
# Motivo: esta pasta tambem guarda binarios da NVIDIA e da Apple, arvores de terceiros e anotacoes pessoais,
# e nada disso pode ir para o repositorio.

# 1) raiz: so estes arquivos e pastas
/*
!/.gitignore
!/.github/
!/README.md
!/README.pt-BR.md
!/CONTRIBUTING.md
!/NOTICE.md
!/LICENSE
!/LICENSES/
!/nvrm_r387.h
!/docs/
!/accel/
!/agdc/
!/fb/
!/kext/
!/libnvrm387/
!/metal/
!/nvk/
!/tools/

# 2) dentro das pastas liberadas: ignora tudo, mantem os diretorios...
/.github/**
/docs/**
/accel/**
/agdc/**
/fb/**
/kext/**
/libnvrm387/**
/metal/**
/nvk/**
/tools/**
!/.github/**/
!/docs/**/
!/accel/**/
!/agdc/**/
!/fb/**/
!/kext/**/
!/libnvrm387/**/
!/metal/**/
!/nvk/**/
!/tools/**/

# 3) ...e libera so fonte e texto (binario compilado nao tem extensao e fica fora)
!*.c
!*.h
!*.cpp
!*.m
!*.metal
!*.inc
!*.sh
!*.md
!*.txt
!*.plist
!*.entitlements
!*.ini
!*.patch
!*.comp
!*.vert
!*.frag
!*.png
!*.yml
!Makefile
!/.github/CODEOWNERS

# 4) o que continua fora mesmo com a extensao liberada
/CLAUDE.md
/PROGRESSO_KIMI.md
.DS_Store
build/
backup/
*.kext/
*.bundle/
*.app/
*.dSYM/
*.orig.cpp
/metal/plugin-src/
/metal/translator-src/
/metal/llvm/
/metal/stage/
/metal/out/
/metal/out-lib/
/nvk/mesa/
/nvk/mesa.nullmoth/
/nvk/build-host/
/nvk/build-x86/
/nvk/venv/
/nvk/dl/
/nvk/orig/
/nvk/out/
/nvk/hosttools/
/kext/gpubundles/nvmtl/
*.kext.*/
